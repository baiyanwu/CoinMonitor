    <string name="about_project_section">About the Project</string>
    <string name="about_project_description">CoinMonitor combines Binance, OKX, and public on-chain market data with a local self-custody wallet. Wallet keys remain on this device and can sign direct transfers; the app does not provide swaps, orders, bridges, or custody.</string>
